pipeline {
    agent any

    stages {
        stage('pull') {
            steps {
               git branch: 'main', url: 'https://github.com/iamtruptimane/node-js-app-CICD.git'
            }
        }
        stage('build') {
            steps {
                echo 'building..'
            }
        }
        stage('test') {
            steps {
                echo 'testing....'
            }
        }
         stage('Deploy') {
            steps {
                echo 'Deploying....'
            }
        }
    }
}